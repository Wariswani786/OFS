      padding: 8px 0;
    }
    .pd-spec-table td {
      padding: 2px 0;
      white-space: normal;
    }
    .pd-spec-table td:first-child {
      width: 100%;
      color: #0A1F3F;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }
  }
</style>

