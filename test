      align-items: center;
      gap: 12px;
      text-align: left;
      padding: 14px 16px;
    }
    .pdesc-feature-icon-wrap {
      margin: 0;
    }
    .pdesc-check-item {
      padding: 13px 0;
    }
    .pd-spec-table tr {
