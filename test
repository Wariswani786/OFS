<style>
  .pp-row {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 56px;
    width: 100%;
    margin: 0;
    align-items: start;
    font-family: Arial, sans-serif;
    padding: 0 clamp(16px, 4vw, 40px);
  }
  .pp-row * { box-sizing: border-box; }

  /* ---------- LEFT: Description ---------- */
  .pdesc-badge {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    background: linear-gradient(135deg, #0A1F3F 0%, #1a3a6e 100%);
    color: #fff;
    font-size: clamp(10.5px, 1.6vw, 11.5px);
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: 4px;
    margin-bottom: 18px;
    box-shadow: 0 2px 8px rgba(10, 31, 63, 0.25);
    font-family: Arial, sans-serif;
  }

  .pdesc-badge span {
    color: #f59e0b;
  }

  .pdesc-heading {
    font-size: clamp(22px, 4vw, 32px);
    font-weight: 800;
    text-transform: uppercase;
    color: #0A1F3F;
    margin: 0 0 16px 0;
    line-height: 1.2;
    letter-spacing: 0.3px;
    font-family: Arial, sans-serif;
    word-wrap: break-word;
  }

  .pdesc-heading::after {
    content: '';
    display: block;
    width: 56px;
    height: 4px;
    background: #0A1F3F;
    border-radius: 2px;
    margin-top: 14px;
  }

  .pdesc-text {
    font-size: clamp(13.5px, 1.8vw, 14.5px);
    color: #374151;
    line-height: 1.75;
    margin: 20px 0 26px 0;
    font-family: Arial, sans-serif;
  }

  .pdesc-text strong {
    color: #0A1F3F;
  }

  .pdesc-feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 0 0 30px 0;
  }

  .pdesc-feature-card {
    border: 1px solid #e5e7eb;
    background: #fafbfc;
    border-radius: 8px;
    padding: 22px 10px;
    text-align: center;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .pdesc-feature-card:hover {
    border-color: #0A1F3F;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(10, 31, 63, 0.1);
  }

  .pdesc-feature-icon-wrap {
    width: 40px;
    height: 40px;
    margin: 0 auto 12px;
    border-radius: 50%;
    background: linear-gradient(135deg, #0A1F3F 0%, #1a3a6e 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pdesc-feature-icon {
    width: 19px;
    height: 19px;
    stroke: #f59e0b;
    fill: none;
    stroke-width: 1.9;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pdesc-feature-label {
    font-size: clamp(10.5px, 1.6vw, 11.5px);
    font-weight: 700;
    letter-spacing: 0.4px;
    text-transform: uppercase;
    color: #0A1F3F;
    font-family: Arial, sans-serif;
  }

  .pdesc-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pdesc-check-item {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 15px 0;
    border-bottom: 1px solid #f3f4f6;
  }

  .pdesc-check-item:last-child {
    border-bottom: none;
  }

  .pdesc-check-mark {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #0A1F3F;
    color: #fff;
    font-size: 11px;
    line-height: 20px;
    text-align: center;
    margin-top: 1px;
