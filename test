  @media (max-width: 640px) {
    .pp-row {
      gap: 28px;
    }
    .pdesc-feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .pd-trigger {
      padding: 16px 16px;
    }
    .pd-content {
      padding: 0 16px 20px;
    }
  }

  @media (max-width: 480px) {
    .pdesc-badge {
