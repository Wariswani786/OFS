    background: none;
    border: none;
    padding: 20px 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    text-align: left;
    gap: 12px;
  }

  .pd-trigger-label {
    font-size: 15px;
    font-weight: 700;
    color: #0A1F3F;
    font-family: Arial, sans-serif;
  }

  .pd-chevron {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    stroke: #6b7280;
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s ease;
  }

  .pd-item.open .pd-chevron {
    transform: rotate(180deg);
    stroke: #0A1F3F;
  }

  .pd-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }

  .pd-item.open .pd-body {
    max-height: 1400px;
  }

  .pd-content {
    padding: 0 22px 24px;
  }

  .pd-spec-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    font-family: Arial, sans-serif;
  }

  .pd-spec-table tr {
    border-bottom: 1px solid #eef0f2;
  }

  .pd-spec-table tr:last-child {
    border-bottom: none;
  }

  .pd-spec-table td {
    padding: 11px 8px;
    vertical-align: top;
    line-height: 1.5;
  }

  .pd-spec-table td:first-child {
    font-weight: 700;
    color: #0A1F3F;
    width: 42%;
    white-space: nowrap;
  }

  .pd-spec-table td:last-child {
    color: #374151;
  }

  .pd-shipping-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .pd-shipping-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .pd-shipping-icon {
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    background: linear-gradient(135deg, #0A1F3F 0%, #1a3a6e 100%);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pd-shipping-icon svg {
    width: 18px;
    height: 18px;
    stroke: #f59e0b;
    fill: none;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .pd-shipping-label {
    font-size: 13.5px;
    font-weight: 700;
    color: #0A1F3F;
    margin: 0 0 3px 0;
    font-family: Arial, sans-serif;
  }

  .pd-shipping-text {
    font-size: 13px;
    color: #4b5563;
    margin: 0;
    line-height: 1.6;
    font-family: Arial, sans-serif;
  }

  /* ================= RESPONSIVE ================= */

  @media (max-width: 860px) {
