  .pdesc-check-text {
    font-size: clamp(13px, 1.8vw, 14px);
    color: #374151;
    line-height: 1.6;
    font-family: Arial, sans-serif;
  }

  .pdesc-check-text strong {
    color: #0A1F3F;
    font-weight: 700;
  }

  /* ---------- RIGHT: Specifications / Shipping & Returns ---------- */
  .pd-wrap {
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 2px 10px rgba(10, 31, 63, 0.05);
  }

  .pd-item {
